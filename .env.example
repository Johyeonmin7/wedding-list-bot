# ── 텔레그램 ──────────────────────────────────────────────
# @BotFather 에서 /newbot 으로 발급받은 토큰
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Google Sheets ─────────────────────────────────────────
# Google Cloud Console > 서비스 계정 > 키 생성(JSON) 후
# 파일 전체 내용을 한 줄로 복사해서 여기에 붙여넣기
# (Railway/Render 등 환경변수로 등록할 때 사용)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── 스프레드시트 설정 (필요 시 변경) ──────────────────────
# 구글 드라이브에서 스프레드시트 이름 (정확히 일치해야 함)
SPREADSHEET_NAME=축의리스트

# 이름이 저장된 컬럼 헤더 (스프레드시트 1행 기준)
NAME_COLUMN=이름

# 금액이 저장된 컬럼 헤더 (/stats 명령어에서 사용)
AMOUNT_COLUMN=액
